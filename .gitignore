# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Logs
*.log

# Pearl Dolt store + other .smooth/* state stay out of git. Pearl
# boards now follow the beads model (pearl th-ad1f41, 2026-06-13):
# `.smooth/dolt/` is gitignored and syncs via dolt's own
# `refs/dolt/data` ref pushed alongside normal git refs
# (`th pearls push` / `th pearls pull`). Matches smooth + smooai which
# made the same flip; eliminates the noms-binary merge-conflict class.
# Fresh clones bootstrap via `th pearls init` which clones from
# refs/dolt/data automatically.
.smooth/*

# Obsidian — workspace state is per-user; vault content is shared.
docs/.obsidian/workspace*
docs/.obsidian/cache

# pnpm + changesets workspace
node_modules/

# Pearl Dolt store — beads model: synced via refs/dolt/data, not tracked.
.smooth/dolt/
